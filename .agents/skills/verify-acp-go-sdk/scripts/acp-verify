#!/usr/bin/env bash
# Build, check, drive and clean up one verification run of the ACP Go SDK
# examples. Every command except launch needs ACP_VERIFY_RUN, which launch
# prints.
#
#   acp-verify launch                      build into a new run folder
#   acp-verify doctor                      read-only: is this run worth driving?
#   acp-verify wire JOURNEY LABEL          drive the example agent with acpwire
#   acp-verify client LABEL INPUT          run the example client CLI with INPUT on stdin
#   acp-verify client-default LABEL INPUT  run `go run ./example/client` with INPUT, then list
#                                          every process that it started and that is still running
#   acp-verify cleanup                     stop this run's processes, delete work/, keep evidence/
#
# Environment:
#   ACP_VERIFY_ROOT  parent folder for runs (default ${TMPDIR:-/tmp}/acp-verify)
#   ACP_VERIFY_RUN   the run folder that launch printed
set -euo pipefail

SKILL_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
REPO=$(cd "$SKILL_DIR/../../.." && pwd)
MARKER=.acp-verify-run

die() {
	echo "acp-verify: $*" >&2
	exit 2
}

# The source state the binaries come from: HEAD plus a hash of every
# uncommitted change and every untracked file that git does not ignore.
source_id() {
	local head dirty
	head=$(git -C "$REPO" rev-parse HEAD)
	dirty=$({
		git -C "$REPO" diff HEAD --binary
		(cd "$REPO" && git ls-files -z --others --exclude-standard | xargs -0r sha256sum)
	} | sha256sum | cut -c1-12)
	echo "$head+$dirty"
}

# start_of PID: the process start time, so a reused PID is never mistaken
# for a process that this run started.
start_of() { ps -o lstart= -p "$1" 2>/dev/null | tr -s ' ' || true; }

# ours PID START: the PID is alive and is still the process recorded.
ours() { [ -n "$2" ] && [ "$(start_of "$1")" = "$2" ]; }

need_run() {
	[ -n "${ACP_VERIFY_RUN:-}" ] || die "ACP_VERIFY_RUN is not set. Run 'acp-verify launch' and export what it prints."
	if [ ! -f "$ACP_VERIFY_RUN/$MARKER" ]; then
		[ -d "$ACP_VERIFY_RUN/evidence" ] && [ ! -d "$ACP_VERIFY_RUN/work" ] &&
			die "$ACP_VERIFY_RUN was cleaned up. Its evidence is kept. Run 'acp-verify launch' for a new run."
		die "$ACP_VERIFY_RUN was not made by acp-verify launch. Refusing to use it."
	fi
	RUN=$ACP_VERIFY_RUN
	WORK=$RUN/work
	EVIDENCE=$RUN/evidence
	BIN=$WORK/bin
}

# Start a command in the background, record its pid, wait for it, and
# return its exit code. Cleanup kills only pids recorded here.
tracked() {
	# <&0: an explicit redirect, or bash gives a background job /dev/null.
	"$@" <&0 &
	local pid=$!
	printf '%s\t%s\t%s\n' "$pid" "$(start_of "$pid")" "$*" >>"$WORK/pids"
	set +e
	wait "$pid"
	local rc=$?
	set -e
	return "$rc"
}

cmd_launch() {
	local root id
	root=${ACP_VERIFY_ROOT:-${TMPDIR:-/tmp}/acp-verify}
	# The root holds binaries that later commands run, so it must be ours and
	# private. mkdir is atomic: either it makes the root 0700, or the checks
	# below judge the folder that is already there.
	mkdir -p "$(dirname "$root")"
	mkdir -m 700 "$root" 2>/dev/null || true
	[ -d "$root" ] && [ ! -L "$root" ] && [ -O "$root" ] ||
		die "refusing $root: it must be a directory that you own, not a symlink"
	[ -z "$(find "$root" -maxdepth 0 \( -perm -0020 -o -perm -0002 \))" ] ||
		die "refusing $root: other users can write to it"
	RUN=$(mktemp -d "$root/$(date +%Y%m%d-%H%M%S)-XXXXXX") || die "cannot create a run folder in $root"
	id=$(basename "$RUN")
	WORK=$RUN/work
	EVIDENCE=$RUN/evidence
	BIN=$WORK/bin
	mkdir -p "$BIN" "$EVIDENCE"
	: >"$WORK/pids"
	echo "$id" >"$RUN/$MARKER"
	local before
	before=$(source_id)
	(
		cd "$REPO"
		go build -o "$BIN/acp-example-agent" ./example/agent
		go build -o "$BIN/acp-example-client" ./example/client
		go build -o "$BIN/acpwire" "$SKILL_DIR/scripts/acpwire/main.go"
	) || die "build failed"
	[ "$(source_id)" = "$before" ] || die "the checkout changed during the build. Run launch again."
	{
		echo "source=$before"
		echo "go=$(go version)"
		echo "built=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
	} >"$WORK/build.env"
	cp "$WORK/build.env" "$EVIDENCE/build.env"
	echo "Built run $id."
	printf 'export ACP_VERIFY_RUN=%q\n' "$RUN"
}

cmd_doctor() {
	need_run
	local ok=1 want have
	for b in acp-example-agent acp-example-client acpwire; do
		if [ -x "$BIN/$b" ]; then echo "ok    $b built"; else
			echo "FAIL  $b missing"
			ok=0
		fi
	done
	want=$(sed -n 's/^source=//p' "$WORK/build.env")
	have=$(source_id)
	if [ "$want" = "$have" ]; then echo "ok    binaries match the checkout ($have)"; else
		echo "FAIL  binaries are from $want, the checkout is $have: run launch again"
		ok=0
	fi
	if [ -x "$BIN/acp-example-agent" ]; then
		if timeout --kill-after=2 5 "$BIN/acp-example-agent" </dev/null >/dev/null 2>&1; then
			echo "ok    agent starts and exits 0 on end of input"
		else
			echo "FAIL  agent did not exit 0 within 5s on end of input"
			ok=0
		fi
	fi
	local live=0 pid start cmd
	while IFS=$'\t' read -r pid start cmd; do
		[ -n "$pid" ] || continue
		if ours "$pid" "$start"; then
			echo "FAIL  pid $pid from this run is still running: $cmd"
			live=1
			ok=0
		fi
	done <"$WORK/pids"
	[ "$live" = 0 ] && echo "ok    no process from this run is running"
	echo "run      $RUN"
	echo "evidence $EVIDENCE"
	[ "$ok" = 1 ] || exit 1
}

cmd_wire() {
	need_run
	local journey=${1:?journey file}
	local label=${2:?label}
	[ -f "$journey" ] || journey=$SKILL_DIR/journeys/$journey
	[ -f "$journey" ] || die "no journey $1"
	local out=$EVIDENCE/$label
	mkdir -p "$out"
	cp "$journey" "$out/journey.jsonl"
	echo "$BIN/acpwire -agent $BIN/acp-example-agent -journey $journey -out $out" >"$out/command.txt"
	set +e
	tracked "$BIN/acpwire" -agent "$BIN/acp-example-agent" -journey "$journey" -out "$out" \
		2>"$out/acpwire.stderr.log" | tee "$out/result.txt"
	local rc=${PIPESTATUS[0]}
	set -e
	cat "$out/acpwire.stderr.log" >&2
	echo "exit=$rc" >>"$out/result.txt"
	echo "evidence $out"
	return "$rc"
}

cmd_client() {
	need_run
	local label=${1:?label}
	local input=${2?input for stdin, such as '1\n'}
	local out=$EVIDENCE/$label
	mkdir -p "$out"
	printf '%b' "$input" >"$out/stdin.txt"
	echo "$BIN/acp-example-client $BIN/acp-example-agent <stdin.txt" >"$out/command.txt"
	local start end rc
	start=$(date +%s%N)
	# The time limit and the 1 MiB output cap stop a client that loops.
	set +e
	tracked timeout --kill-after=5 "${ACP_VERIFY_TIMEOUT:-60}" \
		"$BIN/acp-example-client" "$BIN/acp-example-agent" <"$out/stdin.txt" 2>"$out/stderr.txt" |
		head -c 1048576 >"$out/stdout.txt"
	rc=${PIPESTATUS[0]}
	set -e
	end=$(date +%s%N)
	echo "exit=$rc ms=$(((end - start) / 1000000))" >"$out/result.txt"
	case $rc in
	124) echo "TIMEOUT: the client ran longer than ${ACP_VERIFY_TIMEOUT:-60}s" | tee -a "$out/result.txt" ;;
	141) echo "OUTPUT CAP: the client wrote more than 1 MiB" | tee -a "$out/result.txt" ;;
	esac
	cat "$out/stdout.txt"
	echo "--- exit=$rc, evidence $out"
	return "$rc"
}

# tagged TAG: the pid and command of each process that carries
# ACP_VERIFY_TAG=TAG in its environment. A child inherits the tag, also through
# `go run`, so this finds every process that a tagged command started and
# nothing that another user or another run started.
tagged() {
	local env pid
	for env in /proc/[0-9]*/environ; do
		grep -qzxF "ACP_VERIFY_TAG=$1" "$env" 2>/dev/null || continue
		pid=${env#/proc/}
		pid=${pid%/environ}
		printf '%s %s\n' "$pid" "$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null)"
	done
}

cmd_client_default() {
	need_run
	local label=${1:?label}
	local input=${2?input for stdin, such as '1\n'}
	local out=$EVIDENCE/$label
	[ -d /proc/self ] || die "client-default needs /proc to find the processes that the client started"
	mkdir -p "$out"
	printf '%b' "$input" >"$out/stdin.txt"
	local tag
	tag=$(basename "$RUN")-$label-$$
	echo "cd $REPO && ACP_VERIFY_TAG=$tag go run ./example/client <stdin.txt" >"$out/command.txt"
	local start end client_rc rc
	start=$(date +%s%N)
	cd "$REPO"
	# go run compiles the client and then the agent, so the time limit is
	# longer than for client.
	set +e
	tracked env "ACP_VERIFY_TAG=$tag" timeout --kill-after=5 "${ACP_VERIFY_TIMEOUT:-120}" \
		go run ./example/client <"$out/stdin.txt" 2>"$out/stderr.txt" |
		head -c 1048576 >"$out/stdout.txt"
	client_rc=${PIPESTATUS[0]}
	set -e
	end=$(date +%s%N)
	# The client kills only the `go run` that started the agent. The agent
	# binary exits when it reads end of input, so give it 3 s. Every sleep
	# is followed by a new check.
	local left pid
	left=$(tagged "$tag")
	for _ in $(seq 1 10); do
		[ -z "$left" ] && break
		sleep 0.3
		left=$(tagged "$tag")
	done
	printf '%s' "$left" >"$out/leftover.txt"
	rc=$client_rc
	if [ -n "$left" ]; then
		[ "$rc" = 0 ] && rc=1
		# Record each one, so that doctor reports it and cleanup stops it.
		while read -r pid _; do
			printf '%s\t%s\t%s\n' "$pid" "$(start_of "$pid")" "leftover of $label" >>"$WORK/pids"
		done <<<"$left"
	fi
	{
		echo "exit=$rc client_exit=$client_rc ms=$(((end - start) / 1000000))"
		case $client_rc in
		124) echo "TIMEOUT: the client ran longer than ${ACP_VERIFY_TIMEOUT:-120}s" ;;
		141) echo "OUTPUT CAP: the client wrote more than 1 MiB" ;;
		esac
		if [ -n "$left" ]; then
			echo "LEFTOVER: still running 3 s after the client exited:"
			echo "$left"
		else
			echo "leftover=none"
		fi
	} >"$out/result.txt"
	cat "$out/stdout.txt"
	tail -n +2 "$out/result.txt"
	echo "--- exit=$rc, evidence $out"
	return "$rc"
}

cmd_cleanup() {
	need_run
	local pid start cmd
	while IFS=$'\t' read -r pid start cmd; do
		[ -n "$pid" ] || continue
		if ours "$pid" "$start"; then
			# Kill the recorded process and its direct children (the agent
			# that the client or acpwire started). Never by name.
			pkill -TERM -P "$pid" 2>/dev/null || true
			kill -TERM "$pid" 2>/dev/null || true
			echo "stopped pid $pid ($cmd)"
		fi
	done <"$WORK/pids"
	rm -rf "$WORK"
	rm -f "$RUN/$MARKER"
	echo "removed $WORK"
	echo "evidence kept in $EVIDENCE"
}

case "${1:-}" in
launch) cmd_launch ;;
doctor) cmd_doctor ;;
wire)
	shift
	cmd_wire "$@"
	;;
client)
	shift
	cmd_client "$@"
	;;
client-default)
	shift
	cmd_client_default "$@"
	;;
cleanup) cmd_cleanup ;;
*)
	sed -n '2,15p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
	exit 2
	;;
esac
