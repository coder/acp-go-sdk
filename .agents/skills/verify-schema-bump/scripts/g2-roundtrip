#!/usr/bin/env bash
# G2: round-trip ACP messages through the SDK's Go types and check the
# x-deserialize-* hints, for the checkout this skill sits in.
#
# usage: g2-roundtrip [go test flags, such as -run TestHints]
# env: VSB_ROOT  run folder root (default: ${TMPDIR:-/tmp}/verify-schema-bump)
#
# It writes roundtrip/registry_gen_test.go (not committed) and runs
# `go test ./roundtrip`. Exit 0 when every check passes. Offline once the
# skill module's dependencies are in the Go module cache.
set -euo pipefail

skill=$(cd "$(dirname "$0")/.." && pwd)
root=$(git -C "$skill" rev-parse --show-toplevel)
vsb=${VSB_ROOT:-${TMPDIR:-/tmp}/verify-schema-bump}
run=$vsb/runs/g2-$(cat "$root/schema/version")-$(date +%Y%m%d-%H%M%S)
mkdir -p "$run"
cd "$skill"

go run ./registrygen -sdk "$root" -out roundtrip/registry_gen_test.go | tee "$run/summary.txt"
status=0
go test ./roundtrip -count=1 -v "$@" >"$run/test.log" 2>&1 || status=$?
grep -oE 'SUMMARY .*' "$run/test.log" | tee -a "$run/summary.txt" || true
# A problem line is "TOKEN KEY: DETAIL". failures.txt lists each distinct key
# with the number of distinct lines that have it, so that two runs diff by
# def and property and not by error text, while a new kind of failure at a
# known key still changes its count. details.txt keeps the whole lines.
sed -nE 's/^ +[a-z_]+_test\.go:[0-9]+: ((NO-TYPE|DECODE|VALIDATE|LOSSY|SCHEMA|HINT|PATCH) .*)/\1/p' "$run/test.log" | sort -u >"$run/details.txt"
sed -E 's/: .*//' "$run/details.txt" | sort | uniq -c | sed -E 's/^ *([0-9]+) (.*)/\2 (\1)/' >"$run/failures.txt"
echo "distinct problems by kind:" | tee -a "$run/summary.txt"
awk '{ print $1 }' "$run/failures.txt" | sort | uniq -c | tee -a "$run/summary.txt"
# Fields newer than this schema version that the SDK dropped: reported, not failures.
sed -nE 's/^ +[a-z_]+_test\.go:[0-9]+: (UNKNOWN .*)/\1/p' "$run/test.log" | sed -E 's/: .*//' | sort -u >"$run/unknown.txt"
echo "UNKNOWN (not a failure): $(wc -l <"$run/unknown.txt")" | tee -a "$run/summary.txt"
grep -E '^(FAIL|ok|panic|#)' "$run/test.log" | grep -v '^FAIL$' | tee -a "$run/summary.txt" || true
echo "evidence: $run"
if [ $status = 0 ]; then echo "G2 PASS"; else echo "G2 FAIL"; exit 1; fi
